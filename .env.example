# ─── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3333
# Origem(ns) permitida(s) no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# ─── Banco de dados (PostgreSQL) ──────────────────────────────
# Em produção use a connection string do Postgres do EasyPanel
DATABASE_URL=postgresql://phish:phish@localhost:5432/phishing?schema=public

# ─── Redis (fila de disparo — usado a partir da Sprint 1) ─────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
# Gere segredos fortes: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
JWT_REFRESH_TTL=604800

# ─── Seed do super admin (primeiro acesso da plataforma) ──────
SUPER_ADMIN_EMAIL=admin@rstechsolutions.com.br
SUPER_ADMIN_PASSWORD=troque-esta-senha-forte
SUPER_ADMIN_NAME=Administrador
