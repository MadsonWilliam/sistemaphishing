// Plataforma de simulação de phishing — schema do banco (PostgreSQL)
// Sprint 0: núcleo de multi-tenant, usuários/RBAC e autorização (consentimento LGPD).
// Modelos de campanha/tracking entram na Sprint 1.

generator client {
  provider      = "prisma-client-js"
  // "native" p/ dev local; musl-openssl-3.0 p/ o container Alpine (node:20-alpine).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Papéis (RBAC) ────────────────────────────────────────────
enum Role {
  SUPER_ADMIN // nós, operadores da plataforma
  COMPANY_ADMIN // dono/admin da empresa-cliente
  ANALYST // usuário só-leitura da empresa-cliente
}

enum CompanyStatus {
  PROSPECT // lead vindo da landing, ainda sem contrato
  ACTIVE // contrato ativo, pode rodar campanhas
  SUSPENDED
}

// ─── Empresa (tenant) ─────────────────────────────────────────
model Company {
  id        String        @id @default(uuid())
  name      String
  legalName String? // razão social
  cnpj      String?       @unique
  status    CompanyStatus @default(PROSPECT)

  users          User[]
  authorizations AuthorizationConsent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("companies")
}

// ─── Usuário ──────────────────────────────────────────────────
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean @default(true)

  // SUPER_ADMIN não pertence a nenhuma empresa (companyId nulo).
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  refreshTokens RefreshToken[]
  lastLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("users")
}

// ─── Refresh tokens (rotação de sessão) ───────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Autorização / consentimento (trilho legal LGPD) ──────────
// Uma empresa só pode disparar campanhas com uma autorização ACEITA e vigente.
model AuthorizationConsent {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  acceptedByName  String // quem assinou/aceitou pela empresa
  acceptedByEmail String
  scope           String   @default("Simulação de phishing e conscientização de funcionários")
  documentUrl     String? // link do termo assinado, se houver
  acceptedAt      DateTime @default(now())
  expiresAt       DateTime? // vigência opcional
  revokedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("authorization_consents")
}
