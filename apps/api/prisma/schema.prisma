// Plataforma de simulação de phishing — schema do banco (PostgreSQL)
// Sprint 0: núcleo de multi-tenant, usuários/RBAC e autorização (consentimento LGPD).
// Modelos de campanha/tracking entram na Sprint 1.

generator client {
  provider      = "prisma-client-js"
  // "native" p/ dev local; musl-openssl-3.0 p/ o container Alpine (node:20-alpine).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Papéis (RBAC) ────────────────────────────────────────────
enum Role {
  SUPER_ADMIN // nós, operadores da plataforma
  COMPANY_ADMIN // dono/admin da empresa-cliente
  ANALYST // usuário só-leitura da empresa-cliente
}

enum CompanyStatus {
  PROSPECT // lead vindo da landing, ainda sem contrato
  ACTIVE // contrato ativo, pode rodar campanhas
  SUSPENDED
}

// ─── Empresa (tenant) ─────────────────────────────────────────
model Company {
  id        String        @id @default(uuid())
  name      String
  legalName String? // razão social
  cnpj      String?       @unique
  status    CompanyStatus @default(PROSPECT)

  users          User[]
  authorizations AuthorizationConsent[]
  sendingDomains SendingDomain[]
  emailOutbox    EmailOutbox[]
  templates      Template[]
  campaigns      Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("companies")
}

// ─── Usuário ──────────────────────────────────────────────────
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean @default(true)

  // SUPER_ADMIN não pertence a nenhuma empresa (companyId nulo).
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?

  refreshTokens RefreshToken[]
  lastLoginAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("users")
}

// ─── Refresh tokens (rotação de sessão) ───────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Domínios de envio (transporte SMTP plugável) ─────────────
enum DomainStatus {
  PENDING // criado, ainda não testado
  VERIFIED // conexão SMTP testada com sucesso
  FAILED // teste de conexão falhou
}

// Um domínio a partir do qual disparamos (ex.: dominiolegal.com.br, pagueagora.com.br).
// companyId nulo = domínio da plataforma (pool compartilhado); preenchido = domínio da empresa.
model SendingDomain {
  id        String       @id @default(uuid())
  domain    String // ex.: dominiolegal.com.br
  status    DomainStatus @default(PENDING)

  // Configuração SMTP (senha criptografada em repouso — AES-256-GCM)
  smtpHost         String
  smtpPort         Int     @default(587)
  smtpSecure       Boolean @default(false) // true = TLS implícito (465)
  smtpUsername     String
  smtpPasswordEnc  String // ciphertext (nunca em claro)

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  identities SenderIdentity[]
  lastTestedAt DateTime?
  lastTestError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domain, companyId])
  @@index([companyId])
  @@map("sending_domains")
}

// Identidade de remetente dentro de um domínio (ex.: contas@, fabrica@, juridico@).
model SenderIdentity {
  id        String        @id @default(uuid())
  domain    SendingDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId  String
  localPart String // "contas" -> contas@dominiolegal.com.br
  displayName String // "Financeiro Domínio Legal"
  isActive  Boolean @default(true)

  outbox    EmailOutbox[]

  createdAt DateTime @default(now())

  @@unique([domainId, localPart])
  @@index([domainId])
  @@map("sender_identities")
}

// ─── Outbox de e-mail (fila de envio no Postgres, sem Redis) ──
enum OutboxStatus {
  PENDING // aguardando o horário de envio (gota-a-gota)
  SENDING // sendo processado
  SENT // entregue ao SMTP com sucesso
  FAILED // esgotou tentativas
  CANCELED // cancelado antes do envio
}

model EmailOutbox {
  id String @id @default(uuid())

  senderIdentity   SenderIdentity @relation(fields: [senderIdentityId], references: [id], onDelete: Restrict)
  senderIdentityId String

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String?

  toEmail String
  toName  String?
  subject String
  html    String
  text    String?

  scheduledAt DateTime // quando enviar (gota-a-gota com jitter)
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  sentAt      DateTime?
  providerMessageId String?

  // Ligação com campanha/rastreio (Sprint 2).
  campaignId       String?
  campaignTargetId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([companyId])
  @@map("email_outbox")
}

// ─── Templates, campanhas e rastreio ──────────────────────────
enum TemplateSector {
  FINANCEIRO
  CONTABILIDADE
  JURIDICO
  RH
  TI
  ADMINISTRATIVO
  COMPRAS
  LOGISTICA
  DIRETORIA
  GERAL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELED
}

enum RecurrenceRule {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
}

// Comportamento após o clique — configurável por campanha.
enum PostClickBehavior {
  BLANK // registra o clique e mostra tela em branco
  EDUCATIONAL // vai direto para a página educativa ("você foi testado")
  FORM // formulário falso; ao enviar (sem salvar credenciais) vai para a educativa
}

enum TrackingEventType {
  SENT
  OPENED
  CLICKED
  ATTACHMENT_OPENED
  FORM_SUBMITTED
  REPORTED
}

// Qual o gatilho principal da isca (para as boas práticas do relatório).
enum TemplateTrigger {
  LINK
  ATTACHMENT
  FORM
}

model Template {
  id          String          @id @default(uuid())
  name        String
  sector      TemplateSector  @default(GERAL)
  trigger     TemplateTrigger @default(LINK)
  difficulty  Int             @default(2) // 1 fácil · 2 médio · 3 difícil
  subject     String
  html        String // corpo com placeholders: {{nome}}, {{link}}, {{empresa}}
  landingHtml String? // página educativa custom (senão usa a padrão)

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId String? // null = biblioteca da plataforma

  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("templates")
}

model Campaign {
  id     String         @id @default(uuid())
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  name   String
  template   Template   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateId String
  status CampaignStatus @default(DRAFT)

  // Envio gota-a-gota
  scheduledStartAt  DateTime?
  dripWindowSeconds Int       @default(0)
  dripJitterSeconds Int       @default(0)

  // Configuração pós-clique (por envio)
  postClickBehavior  PostClickBehavior @default(EDUCATIONAL)
  showReportButton   Boolean           @default(false)
  microTraining      Boolean           @default(false)
  landingRedirectUrl String?

  // Domínio próprio para os links/landing de rastreio (ex.: link.rsweb.net.br).
  // Deve apontar para esta aplicação (DNS + domínio no serviço). Se nulo, usa
  // o domínio base da plataforma.
  linkDomain String?

  // Marca do cliente na landing (mais convincente).
  brandLogoUrl String?
  brandColor   String?
  // Trilha de treino opcional (link) mostrada a quem cai.
  trainingUrl String?

  // Recorrência automática (mede evolução sozinho).
  recurrence        RecurrenceRule @default(NONE)
  nextRunAt         DateTime?
  senderIds         String[] // remetentes p/ auto-envio nas execuções recorrentes
  recurringParentId String? // campanha-mãe que gerou esta execução

  // Link público de relatório (read-only) para prospects, sem login.
  reportToken String? @unique

  targets   CampaignTarget[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([companyId])
  @@index([status])
  @@map("campaigns")
}

model CampaignTarget {
  id         String   @id @default(uuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  token      String   @unique // opaco, usado nos links/pixel de rastreio

  toEmail    String
  toName     String?
  department String?

  senderIdentityId String? // atribuído no envio (rotação de remetente)
  outboxId         String? // referência ao EmailOutbox gerado

  // Primeiro evento de cada tipo (conveniência para a dashboard)
  sentAt      DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  submittedAt DateTime?
  reportedAt  DateTime?
  // Último toque no link-canário (honeypot) — indica varredura por scanner.
  lastCanaryAt DateTime?

  events    TrackingEvent[]
  createdAt DateTime        @default(now())

  @@index([campaignId])
  @@map("campaign_targets")
}

model TrackingEvent {
  id       String            @id @default(uuid())
  target   CampaignTarget    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId String
  type     TrackingEventType
  ip        String?
  userAgent String?
  // Evento automático (proxy/scanner/lib) vs. humano — não conta no funil.
  isBot     Boolean @default(false)
  botReason String?
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([type])
  @@index([isBot])
  @@map("tracking_events")
}

// ─── Autorização / consentimento (trilho legal LGPD) ──────────
// Uma empresa só pode disparar campanhas com uma autorização ACEITA e vigente.
model AuthorizationConsent {
  id        String   @id @default(uuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String

  acceptedByName  String // quem assinou/aceitou pela empresa
  acceptedByEmail String
  scope           String   @default("Simulação de phishing e conscientização de funcionários")
  documentUrl     String? // link do termo assinado, se houver
  acceptedAt      DateTime @default(now())
  expiresAt       DateTime? // vigência opcional
  revokedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("authorization_consents")
}

// ─── Leads comerciais (formulário da landing) ─────────────────
// Solicitações de demonstração vindas do site público. Persistidas para nunca
// perder um contato mesmo se a notificação por e-mail falhar.
model Lead {
  id        String   @id @default(uuid())
  name      String
  company   String
  email     String
  phone     String?
  employees String? // faixa de nº de funcionários (texto livre/opcional)
  message   String?
  source    String   @default("landing")
  notified  Boolean  @default(false) // e-mail de notificação enviado?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("leads")
}
